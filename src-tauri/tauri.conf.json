{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Folder Insight",
  "version": "1.1.0",
  "identifier": "com.xiaoyu.folder-insight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Folder Insight",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "CN=晓宇映辰",
    "shortDescription": "High-performance folder analysis tool.",
    "longDescription": "晓宇映辰",
    "windows": {
      "wix": {
        "language": ["zh-CN", "en-US"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
